{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci --include=dev --include=optional --ignore-scripts",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "packages/web/.next",
  "crons": [
    {
      "path": "/api/cron/refresh-claude-creds",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/agent-lifecycle",
      "schedule": "* * * * *"
    }
  ]
}
