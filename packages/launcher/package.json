{
  "name": "switchboard",
  "version": "1.0.2",
  "description": "Launch the Switchboard desktop app with one command \u2014 npx switchboard. Always runs the latest published version.",
  "type": "commonjs",
  "bin": {
    "switchboard": "bin/switchboard.js"
  },
  "files": [
    "bin",
    "lib",
    "app",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bundle": "node scripts/bundle-app.mjs",
    "prepack": "node scripts/bundle-app.mjs",
    "start": "node bin/switchboard.js",
    "typecheck": "node --check bin/switchboard.js && node --check lib/ui.js"
  },
  "dependencies": {
    "electron": "^33.2.1",
    "electron-updater": "^6.3.9",
    "isomorphic-git": "^1.38.3"
  },
  "keywords": [
    "switchboard",
    "electron",
    "launcher",
    "npx",
    "desktop"
  ],
  "license": "MIT",
  "author": "James Murdza",
  "homepage": "https://switchboard.local",
  "repository": {
    "type": "git",
    "url": "https://github.com/burhankhatri/switchboard.git",
    "directory": "packages/launcher"
  }
}
